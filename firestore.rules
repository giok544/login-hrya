rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
             data.sessionAlertsEnabled is bool &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 200)) &&
             (!('phoneLabel' in data) || data.phoneLabel == null || (data.phoneLabel is string && data.phoneLabel.size() <= 30));
    }

    function isValidLoginSession(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.deviceName is string && data.deviceName.size() >= 1 && data.deviceName.size() <= 80 &&
             data.osVersion is string && data.osVersion.size() >= 1 && data.osVersion.size() <= 40 &&
             data.authProvider is string && data.authProvider.size() >= 1 && data.authProvider.size() <= 30 &&
             (!('sessionNote' in data) || data.sessionNote == null || (data.sessionNote is string && data.sessionNote.size() <= 120)) &&
             data.status in ['active', 'verified', 'signed_out'];
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       isOwner(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'email', 'sessionAlertsEnabled', 'lastLoginAt', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'bio', 'phoneLabel', 'sessionAlertsEnabled', 'lastLoginAt', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().lastLoginAt is timestamp && incoming().lastLoginAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isOwner(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().lastLoginAt is timestamp && incoming().lastLoginAt <= request.time &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'lastLoginAt', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'bio', 'phoneLabel', 'sessionAlertsEnabled', 'updatedAt'])
                       );

      allow delete: if isSignedIn() && isValidId(userId) && isOwner(userId);

      match /login_sessions/{sessionId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(sessionId) && isOwner(userId);
        allow list: if isSignedIn() && isValidId(userId) && isOwner(userId);

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(sessionId) &&
                         isOwner(userId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'deviceName', 'osVersion', 'authProvider', 'status', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'deviceName', 'osVersion', 'authProvider', 'sessionNote', 'status', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidLoginSession(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(sessionId) &&
                         isOwner(userId) &&
                         isValidLoginSession(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         existing().status != 'signed_out' &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['sessionNote', 'status', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(sessionId) && isOwner(userId);
      }
    }
  }
}
